# Force text files to LF in the repo
* text=auto eol=lf

# Explicit common text files
*.R     text eol=lf
*.Rmd   text eol=lf
*.Rd    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
DESCRIPTION text eol=lf
NAMESPACE    text eol=lf
LICENSE      text eol=lf

# Treat data/binaries as binary (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.rds   binary
*.RData binary
*.rda binary
*.zip   binary
*.tar   binary
*.gz    binary
